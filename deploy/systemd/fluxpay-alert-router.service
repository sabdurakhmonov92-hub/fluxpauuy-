[Unit]
Description=FluxPay SEV1 Alert Router and Dead-Man Switch Heartbeat Bridge
Documentation=https://github.com/fluxpay/fluxpay/blob/main/docs/architecture.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=fluxpay-worker
Group=fluxpay
UMask=0027
WorkingDirectory=/opt/fluxpay/current

# Long-running alert router process.
# PORT 9120 NOTE: Bound strictly to 127.0.0.1:9120 (localhost-only).
# Receives webhook alerts from Prometheus Alertmanager; never exposed externally.
ExecStart=/opt/fluxpay/current/.venv/bin/python -m fluxpay.alerts

# EnvironmentFile: Doppler-rendered environment variables. NO secrets in unit files.
EnvironmentFile=/etc/fluxpay/env
Restart=always
RestartSec=3
TimeoutStopSec=15

# ==============================================================================
# HARDENING BLOCK (PLATFORM SECURITY ARMOR)
# Every directive is strictly documented with operational rationale.
# ==============================================================================
# Prevent process and descendants from gaining new privileges via setuid/setgid binaries.
NoNewPrivileges=true

# Mount /usr, /boot, and /etc as read-only.
ProtectSystem=strict

# Explicitly whitelist the runtime directory for Unix domain sockets and PID files.
ReadWritePaths=/run/fluxpay

# Make /home, /root, and /run/user inaccessible to the service.
ProtectHome=true

# Provide an isolated, private /tmp and /var/tmp mounted on a private filesystem namespace.
PrivateTmp=true

# Restrict access to physical hardware devices; provides an empty pseudo /dev.
PrivateDevices=true

# Protect kernel variables (/proc/sys, /sys) against modification.
ProtectKernelTunables=true

# Disallow loading or unloading of kernel modules.
ProtectKernelModules=true

# Disallow modifications to cgroup hierarchies via /sys/fs/cgroup.
ProtectControlGroups=true

# Prevent service from altering system clock or real-time clock.
ProtectClock=true

# Prevent service from modifying system hostname or domainname.
ProtectHostname=true

# Minimal address family allowance: AF_UNIX and AF_INET (localhost HTTP and Alertmanager hooks).
RestrictAddressFamilies=AF_UNIX AF_INET

# Resource quotas preventing runaway memory consumption or fork bombs.
MemoryMax=2G
TasksMax=256
LimitNOFILE=65535

# System call whitelist allowing standard system service syscalls.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Lock personality to prevent execution domain switching.
LockPersonality=true

# Restrict namespace creation.
RestrictNamespaces=true

# Restrict real-time scheduling.
RestrictRealtime=true

# Hide processes owned by other users from /proc.
ProtectProc=invisible
ProcSubset=pid

# Drop all POSIX capabilities; pure unprivileged user execution.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
