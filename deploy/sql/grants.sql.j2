-- Rendered by Ansible (template module) with the real role; NEVER applied raw; NEVER referenced by migrate.sh.
-- ==============================================================================
-- Deploy Grants: Append-Only Production Role Contract
-- Environment-agnostic artifact applied by Ansible.
-- Ansible substitutes the real role.
--
-- NOTE: If migrations already created these tables, grants.sql.j2 must run AFTER migrate.sh.
-- ==============================================================================

-- Deny-by-default to public
REVOKE ALL ON ledger_entries FROM PUBLIC;
REVOKE ALL ON ledger_accounts FROM PUBLIC;
REVOKE ALL ON ledger_chain_tip FROM PUBLIC;

-- Core append-only blueprint grant: app role can append, never rewrite
GRANT SELECT, INSERT ON ledger_entries TO {{ app_role }};

-- TRUNCATE is the forgotten one - it bypasses row DELETE thinking
REVOKE UPDATE, DELETE, TRUNCATE ON ledger_entries FROM {{ app_role }};

-- Mutable cache by design (balance/version OCC updates)
GRANT SELECT, INSERT, UPDATE, DELETE ON ledger_accounts TO {{ app_role }};

-- Pointer is mutable; deleting it would orphan the chain
GRANT SELECT, INSERT, UPDATE ON ledger_chain_tip TO {{ app_role }};
REVOKE DELETE, TRUNCATE ON ledger_chain_tip FROM {{ app_role }};

-- ==============================================================================
-- THE MONTH-BOUNDARY TRAP (CRITICAL):
-- Future partitions (created monthly by create_month_partition) must inherit
-- grants automatically. Without ALTER DEFAULT PRIVILEGES, next month's partition
-- is created without SELECT/INSERT permissions for the app role, and all payment
-- execution fails instantly at 00:00:00 on the first day of the month.
-- ==============================================================================
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT ON TABLES TO {{ app_role }};
