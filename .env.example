# ==============================================================================
# FluxPay Environment Contract (Doppler-compatible)
#
# Doppler usage note: Run `doppler setup` to bind this repository to your project/config.
# In production and CI, secrets map to FLX_ vars directly at process start.
# This .env file is local-dev fallback only; NEVER commit .env.
# ==============================================================================

# --- Postgres ---
# [REQUIRED] Primary PostgreSQL connection DSN (must start with postgresql:// or postgres://)
FLX_PG_DSN="postgresql://test:test@localhost:5432/test"

# [OPTIONAL default=2] Minimum idle database connections maintained in the pool
FLX_PG_POOL_MIN=2

# [OPTIONAL default=20] Maximum pool connections (PgBouncer sits in front in production)
FLX_PG_POOL_MAX=20

# --- Valkey / RabbitMQ ---
# [OPTIONAL default=redis://localhost:6379/0] Valkey connection URL for rate limiting and locks
FLX_VALKEY_URL="redis://localhost:6379/0"

# [OPTIONAL default=amqp://localhost:5672/] RabbitMQ AMQP broker URL for async ledger messaging
FLX_RABBITMQ_URL="amqp://localhost:5672/"

# --- Secrets (REQUIRED — app refuses to boot without them) ---
# [REQUIRED] AES-256-GCM vault master key (32 bytes base64-encoded; generate: openssl rand -base64 32)
FLX_VAULT_MASTER_KEY="CHANGE_ME_base64_of_openssl_rand_base64_32"

# [REQUIRED] Outbound webhook HMAC-SHA256 signing secret (min 32 chars; generate: openssl rand -hex 32)
FLX_WEBHOOK_SIGNING_KEY="CHANGE_ME_min_32_char_hex_string_from_openssl"

# --- Gateway (anti-replay / rate / quota — blueprint §3) ---
# [OPTIONAL default=30000] Strict anti-replay timestamp window in milliseconds (±30s)
FLX_REPLAY_WINDOW_MS=30000

# [OPTIONAL default=60000] Agent rate limiting sliding window duration in milliseconds
FLX_RATE_LIMIT_WINDOW_MS=60000

# [OPTIONAL default=100] Maximum allowed requests per agent per rate limit window
FLX_RATE_LIMIT_MAX=100

# [OPTIONAL default=10000] Maximum cumulative daily operations allowed per agent account
FLX_DAILY_QUOTA_MAX=10000

# [OPTIONAL default=120000] Nonce TTL in milliseconds (must be >= 2 * replay_window_ms to cover clock skew)
FLX_NONCE_TTL_MS=120000

# --- Ledger ---
# [OPTIONAL default=5] Maximum optimistic concurrency control (OCC) transaction retries
FLX_LEDGER_MAX_OCC_RETRIES=5

# --- Environment / ops ---
# [OPTIONAL default=development] Operational environment: development | staging | production
FLX_ENV="development"

# [OPTIONAL default=INFO] Structured logging level threshold: DEBUG | INFO | WARNING | ERROR
FLX_LOG_LEVEL="INFO"

# [OPTIONAL default=None] Sentry error tracking DSN (leave empty in local development)
FLX_SENTRY_DSN=""

# --- Task 22 append ---
# [OPTIONAL default=86400] Idempotency fast-path Redis cache TTL in seconds (24h hot-path retention)
FLX_IDEMPOTENCY_FAST_TTL_S=86400

# --- Task 29 append ---
# [REQUIRED] Keycloak JWKS endpoint URL (must start with https://)
FLX_KEYCLOAK_JWKS_URL="https://auth.fluxpay.local/realms/fluxpay/protocol/openid-connect/certs"

# [REQUIRED] Keycloak OIDC issuer URL (must start with https://)
FLX_KEYCLOAK_ISSUER="https://auth.fluxpay.local/realms/fluxpay"

# [REQUIRED] Keycloak client audience (must start with https://)
FLX_KEYCLOAK_AUDIENCE="https://api.fluxpay.local"


# --- Task 43 append ---
# [OPTIONAL default=None] Telegram Bot API token for admin hold notifications.
# Leave empty to disable Telegram adapter (LoggingStubNotifier used instead).
# Generate: create a bot via @BotFather on Telegram.
# SECURITY: treat like a password -- never commit to source control.
FLX_TELEGRAM_BOT_TOKEN=""

# [OPTIONAL default=None] Telegram chat_id for admin alerts (group, channel, or user).
# REQUIRED if FLX_TELEGRAM_BOT_TOKEN is set -- both must be configured or both absent.
# Find chat_id by sending a message to your bot then GET getUpdates.
FLX_TELEGRAM_ADMIN_CHAT_ID=""

# [OPTIONAL default=None] SendGrid v3 API key for transactional emails (Phase 1: admin invites).
# Leave empty to disable email adapter. Phase 1: merchant emails are dashboard-only (Task 62).
# SECURITY: treat like a password -- never commit to source control.
FLX_SENDGRID_API_KEY=""

# [OPTIONAL default=noreply@fluxpay.local] From-address for transactional emails.
# Must be a verified sender in SendGrid when FLX_SENDGRID_API_KEY is set.
FLX_EMAIL_FROM="noreply@fluxpay.local"

# [OPTIONAL default=5] Max notification delivery attempts before recording to failure ledger.
FLX_NOTIFICATION_RETRY_MAX=5

# [OPTIONAL default=2.0] Base backoff seconds for notification retry ladder (2^n scaling).
FLX_NOTIFICATION_BACKOFF_BASE_S=2.0

# --- Task 50 append ---
# [OPTIONAL default=None] Base L2 JSON-RPC HTTP endpoint URL.
# If unset or empty, BaseL2Reader operates in disabled mode via NullReader.
# Mainnet: https://mainnet.base.org or your private provider (Alchemy/Infura/QuickNode).
# Testnet (Base Sepolia): https://sepolia.base.org
FLX_BASE_RPC_URL=""

# [OPTIONAL default=8453] Base chain ID.
# Base Mainnet = 8453; Base Sepolia Testnet = 84532.
FLX_BASE_CHAIN_ID=8453
# FLX_BASE_CHAIN_ID=84532

# [OPTIONAL default=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913] Base USDC token contract address.
# Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Testnet (Base Sepolia): 0x036CbD53842c5426634e7929541eC2318f3dCF7e
FLX_BASE_USDC_ADDRESS="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"

# [OPTIONAL default=10.0] Base L2 RPC query timeout in seconds.
FLX_BASE_READER_TIMEOUT_S=10.0

# --- Task 52 append ---
# [OPTIONAL default=None] Stripe secret API key (sandbox/test keys start with sk_test_).
# Unset or empty disables Stripe integration.
FLX_STRIPE_SECRET_KEY=""

# [OPTIONAL default=None] Stripe webhook signing secret (sandbox/test keys start with whsec_).
# Must be at least 16 characters if configured.
FLX_STRIPE_WEBHOOK_SECRET=""

# [OPTIONAL default=https://api.stripe.com] Stripe API base URL.
FLX_STRIPE_API_BASE="https://api.stripe.com"

# [OPTIONAL default=300] Stripe webhook timestamp tolerance in seconds for replay protection.
FLX_STRIPE_WEBHOOK_TOLERANCE_S=300

# --- Task 53 append ---
# [OPTIONAL default=None] Wise API key (read/write profile credential; treat with extreme care).
# Unset or empty disables Wise integration. (Sandbox keys generated in sandbox account settings;
# production keys generated in live Wise business profile — never commit).
FLX_WISE_API_KEY=""

# [OPTIONAL default=https://api.sandbox.transferwise.tech] Wise API base URL.
# NOTE: PRODUCTION base is https://api.transferwise.tech — set ONLY with prod keys; the code default stays sandbox.
FLX_WISE_API_BASE="https://api.sandbox.transferwise.tech"

# [OPTIONAL default=None] Wise webhook signing secret for signature verification.
FLX_WISE_WEBHOOK_SECRET=""

# [OPTIONAL default=300] Wise webhook timestamp tolerance in seconds (if payload timestamp is present).
FLX_WISE_WEBHOOK_TOLERANCE_S=300

# --- Task 55 append ---
# [OPTIONAL default=None] Sumsub App Token / API Key.
# Leave empty to disable Sumsub adapter (ManualProvider used instead).
# Sandbox: https://api.sumsub.com (or test tenant endpoint)
FLX_SUMSUB_API_KEY=""

# [OPTIONAL default=None] Sumsub Secret Key for request HMAC-SHA256 signing and webhook verification.
# SECURITY: treat like a password — never commit to source control.
FLX_SUMSUB_SECRET_KEY=""

# [OPTIONAL default=https://api.sumsub.com] Sumsub API base URL.
FLX_SUMSUB_BASE="https://api.sumsub.com"

# [OPTIONAL default=basic-kyc-level] Sumsub verification level name configured in Sumsub dashboard.
FLX_SUMSUB_LEVEL_NAME="basic-kyc-level"

# [OPTIONAL default=None] Trulioo API key for x-trulioo-api-key / Bearer authentication.
# Leave empty to disable Trulioo adapter (ManualProvider used instead).
# Sandbox: https://gateway.trulioo.com (test environment)
FLX_TRULIOO_API_KEY=""

# [OPTIONAL default=https://gateway.trulioo.com] Trulioo API base URL.
FLX_TRULIOO_BASE="https://gateway.trulioo.com"

# [OPTIONAL default=manual] Default KYC provider: 'manual' | 'sumsub' | 'trulioo'.
FLX_KYC_PROVIDER_DEFAULT="manual"

# --- Task 61 append ---
# [OPTIONAL default=None] Dedicated secret key for signing dashboard session cookies and OAuth state.
# Leave empty to disable admin dashboard. Generate: openssl rand -hex 32.
FLX_DASHBOARD_SECRET=""

# [OPTIONAL default=flx_dash] Name of the dashboard session cookie stored in browser.
FLX_DASHBOARD_SESSION_COOKIE_NAME="flx_dash"

# [OPTIONAL default=28800] Lifetime of dashboard session cookie in seconds (8h workday).
FLX_DASHBOARD_COOKIE_MAX_AGE_S=28800

# [OPTIONAL default=http://localhost:8000] Allowed origin for CSRF mutation guard checks.
FLX_DASHBOARD_ORIGIN="http://localhost:8000"

# --- Task 69: Observability & Alert Router ---
# [OPTIONAL default=true] Enable Prometheus metrics exposition
FLX_METRICS_ENABLED=true

# [OPTIONAL default=9110] Base port for Prometheus metrics scraping
FLX_METRICS_PORT_BASE=9110

# [OPTIONAL default=9120] Port for SEV1 Alert Router HTTP service
FLX_ALERT_ROUTER_PORT=9120

# [OPTIONAL default=None] Shared bearer secret for alertmanager webhook auth
FLX_ALERTROUTER_SECRET=""

# --- Task 51 append ---
# [OPTIONAL default=None] Ethereum L1 JSON-RPC HTTP endpoint URL.
# If unset or empty, the 'ethereum_usdc' rail is omitted from the registry (disabled mode).
# Mainnet: https://eth-mainnet.g.alchemy.com/v2/YOUR-API-KEY or your private provider.
# Testnet (Ethereum Sepolia): https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY
FLX_ETH_RPC_URL=""

# [OPTIONAL default=1] Ethereum chain ID.
# Ethereum Mainnet = 1; Ethereum Sepolia Testnet = 11155111.
FLX_ETH_CHAIN_ID=1
# FLX_ETH_CHAIN_ID=11155111

# [OPTIONAL default=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48] Ethereum USDC contract address.
# Mainnet: 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# Testnet (Ethereum Sepolia): 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
FLX_ETH_USDC_ADDRESS="0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"

# [OPTIONAL default=1] Minimum confirmations required before a transaction is treated as confirmed.
# RUNBOOK NOTE: Ethereum mainnet receipts are confirmed at 1 block for standard monitoring,
# but treasury-scale decisions / cold-to-hot sweeps MUST observe full Casper FFG finality (~13 min, 2 epochs).
FLX_ETH_CONFIRMATIONS_MIN=1

