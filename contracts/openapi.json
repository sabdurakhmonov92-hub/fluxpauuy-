        "summary": "Vote Hold",
        "description": "Submit an approval or rejection vote on a quarantined payment hold.\n\nRole Requirement: 'admin' only.\nRequest Body:\n    {\"vote\": \"approve\" | \"reject\", \"note\": \"optional justification\"}\nResponse (200 OK):\n    {\"status\": \"counted\" | \"approved_settled\" | \"rejected\" | \"already_voted\",\n     \"votes_for\": int, \"votes_against\": int}",
        "operationId": "vote_hold_admin_holds__hold_id__vote_post",
        "parameters": [
          {
            "name": "hold_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Hold Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
