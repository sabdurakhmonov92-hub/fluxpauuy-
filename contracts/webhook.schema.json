{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxpay.io/schemas/webhook-v1.json",
  "$comment": "frozen merchant contract — additive only; new fields optional with defaults; breaking = new $id",
  "title": "FluxPayWebhookEvent",
  "description": "Merchant-facing webhook event notification contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "event_id",
    "created_at",
    "data"
  ],
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "payment.settled",
        "payment.held",
        "payment.failed"
      ],
      "description": "Domain event type identifier mirroring Task 9 EventType."
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event dispatch identifier."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp of event generation."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tx_id",
        "amount",
        "currency"
      ],
      "properties": {
        "tx_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique ledger transaction identifier."
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "description": "Payment amount in minor units."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,10}$",
          "description": "Currency code mirroring Task 12 law L1."
        }
      }
    }
  }
}
