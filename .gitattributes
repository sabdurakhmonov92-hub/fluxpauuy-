# Normalize line endings: store as LF in repo, checkout as-is
* text=auto eol=lf

# Force LF for all source files
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
*.js    text eol=lf
*.sh    text eol=lf
*.conf  text eol=lf
*.lock  text eol=lf

# Force LF for Docker/infra files
Dockerfile      text eol=lf
.dockerignore   text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.pdf   binary
